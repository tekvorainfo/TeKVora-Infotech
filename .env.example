# TeKVora local environment variables template
# Copy this file to a new file named '.env' in the same folder and fill in your Supabase credentials.

# Your Supabase Project API URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
